{
  "name": "pairlobby-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "install:cli": "npm run build && npm link --workspace @pairlobby/cli",
    "uninstall:cli": "npm unlink -g pairlobby",
    "test": "tsc --build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
