{
  "name": "pairlobby-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc --build && node scripts/fix-bin.mjs",
    "clean": "tsc --build --clean",
    "serve": "npm run build --silent && node packages/cli/dist/main.js serve",
    "install:cli": "npm run build && npm link --workspace @pairlobby/cli",
    "uninstall:cli": "npm unlink -g pairlobby",
    "test": "tsc --build && node scripts/fix-bin.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "service": "node scripts/service.mjs",
    "service:install": "npm run install:cli && node scripts/service.mjs install",
    "service:status": "node scripts/service.mjs status",
    "service:uninstall": "node scripts/service.mjs uninstall",
    "test:hosted": "npm run build && node --test --test-concurrency=1 packages/hosted/test/*.test.mjs",
    "typecheck:hosted": "tsc -p packages/hosted --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "0.28.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
