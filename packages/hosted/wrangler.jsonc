{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "a633403707f87dbc5de9aac0e55d5b99",
  "name": "pairlobby-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": ["pairlobby.com/api/*", "pairlobby.com/relay/*"],
  "triggers": {"crons": ["*/15 * * * *"]},
  "vars": {"APP_ORIGIN": "https://pairlobby.com", "SIGNUPS_ENABLED": "true", "BILLING_ENABLED": "false", "CURRENCY": "usd"},
  "d1_databases": [{"binding": "DB", "database_name": "pairlobby-accounts", "database_id": "534e1ac7-432d-442e-a892-ed75b3787e7b", "migrations_dir": "migrations"}],
  "send_email": [{"name": "EMAIL", "allowed_sender_addresses": ["accounts@pairlobby.com"]}],
  "durable_objects": {"bindings": [{"name": "WORKSPACES", "class_name": "Workspace"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Workspace"]}],
  "ratelimits": [{"name": "PUBLIC_RATE_LIMIT", "namespace_id": "1001", "simple": {"limit": 30, "period": 60}}],
  "observability": {"enabled": true, "head_sampling_rate": 0.01},
  "limits": {"cpu_ms": 1000}
}
